# Copy to .streamlit/secrets.toml to REQUIRE sign-in (Microsoft work accounts shown).
# Without a secrets.toml the app runs open, with one shared library ("local").
# Never commit the real secrets.toml to git.

# Optional: only let these email domains in
allowed_domains = ["soundblademedical.com"]

[auth]
redirect_uri = "https://beamlab.your-company.example/oauth2callback"   # http://localhost:8501/oauth2callback when testing
cookie_secret = "replace-with-a-long-random-string"                    # e.g. python -c "import secrets; print(secrets.token_hex(32))"

[auth.microsoft]
client_id = "<Application (client) ID from the Entra app registration>"
client_secret = "<client secret value>"
server_metadata_url = "https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration"
